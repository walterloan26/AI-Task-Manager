generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String?
  email        String   @unique
  image         String?
  emailVerified DateTime?
  lastLoginAt   DateTime?
  passwordHash String?
  role         String   @default("USER") // replaced enum with string
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  failedLoginAttempts   Int      @default(0)
  lockedUntil           DateTime?
  aiCallsToday     Int      @default(0)
  aiLastResetAt    DateTime @default(now())

  accounts Account[]
  sessions Session[]
  tasks    Task[]

  @@index([role])
  @@index([isActive])
}

model Task {
  id           String    @id @default(cuid())
  task         String
  complexity   String    @default("MEDIUM")
  aiGenerated  Boolean   @default(false)
  aiConfidence Float?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  subtasks     Subtask[]
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subtask {
  id              String    @id @default(cuid())
  title           String
  description     String
  estimateMinutes Int       @default(0)
  completed       Boolean   @default(false)
  priority        String    @default("MEDIUM")
  orderIndex      Int
  taskId          String
  task            Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  isDeleted       Boolean  @default(false)  // Add this field

  @@index([taskId, orderIndex])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}
