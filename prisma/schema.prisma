generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Task {
  id        String    @id @default(cuid())
  task      String
  createdAt DateTime  @default(now())
  subtasks  Subtask[]
  complexity String?  @default("medium")
}

model Subtask {
  id              String   @id @default(cuid())
  title           String
  description     String
  estimateMinutes Int
  completed       Boolean  @default(false)

  taskId          String
  task            Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  priority        String   @default("Medium") // must exist
  
  orderIndex      Int      // NEW — required for stable ordering
  @@index([taskId, orderIndex])
  @@unique([taskId, orderIndex])
}

