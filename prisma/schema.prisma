generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String?
  email        String   @unique
  image        String?
  emailVerified DateTime?
  lastLoginAt   DateTime?
  passwordHash String?

  role         String   @default("USER")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  failedLoginAttempts   Int      @default(0)
  lockedUntil           DateTime?
  aiCallsToday     Int      @default(0)
  aiLastResetAt    DateTime @default(now())

  accounts Account[]
  sessions Session[]
  createdTasks  Task[] @relation("CreatedTasks")
  assignedTasks Task[] @relation("AssignedTasks")
  tasks         Task[] @relation("UserTasks")  // Added for Task.user relation
  activities    Activity[]                     // Added for Activity.actor relation

  @@index([role])
  @@index([isActive])
}

model Task {
  id           String    @id @default(cuid())
  task         String
  complexity   String    @default("MEDIUM")
  aiGenerated  Boolean   @default(false)
  aiConfidence Float?
  
  status       String    @default("PENDING")

  // Admin who created it
  createdById String
  createdBy   User @relation("CreatedTasks", fields: [createdById], references: [id])

  // User assigned to execute
  assignedToId String
  assignedTo   User @relation("AssignedTasks", fields: [assignedToId], references: [id])

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  subtasks     Subtask[]
  
  // Changed from 'user' to 'owner' to avoid confusion
  ownerId       String
  owner         User      @relation("UserTasks", fields: [ownerId], references: [id], onDelete: Cascade)
  
  activities   Activity[]  // Added for Activity.task relation

  @@index([assignedToId])
  @@index([createdById])
  @@index([status])
  @@index([ownerId])
}

model Subtask {
  id              String    @id @default(cuid())
  title           String
  description     String
  estimateMinutes Int       @default(0)
  completed       Boolean   @default(false)
  priority        String    @default("MEDIUM")
  orderIndex      Int
  taskId          String
  task            Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  isDeleted       Boolean  @default(false)

  @@index([taskId, orderIndex])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Activity {
  id String @id @default(cuid())

  type String

  // Who performed the action
  actorId String
  actor   User @relation(fields: [actorId], references: [id], onDelete: Cascade)

  // Optional context
  taskId    String?
  task      Task?   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  subtaskId String?
  // no direct relation needed unless you want it

  // SQLite doesn't support Json type. Use String and store JSON as text
  meta String?

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([taskId])
  @@index([type])
  @@index([createdAt])
}